{
  "manifest_version": 3,
  "name": "Plugin Manager",
  "version": "1.0.0",
  "description": "Tabbed host for every plugin in the Plugins folder.",
  "permissions": [
    "sidePanel",
    "storage",
    "alarms",
    "idle",
    "clipboardRead",
    "clipboardWrite",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "action": {
    "default_title": "Plugin Manager"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://dash.metapcs.com/*",
    "https://*.gorgias.com/*",
    "https://metapcs-platform.web.app/*",
    "https://firestore.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://admin.shopify.com/*",
    "https://help.metapcs.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "https://app.workmatepos.co/*"],
  "content_scripts": [
    {
      "matches": ["https://dash.metapcs.com/*"],
      "js": ["Plugins/PoundList-Tool-main/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://admin.shopify.com/*"],
      "js": ["Plugins/Warranty-Tool/content.js"],
      "css": ["Plugins/Warranty-Tool/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://admin.shopify.com/*",
        "https://*.gorgias.com/*",
        "https://*.workmatepos.co/*"
      ],
      "js": ["Plugins/metapcs-toolbox/content/linkify.js"],
      "css": ["Plugins/metapcs-toolbox/content/linkify.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://admin.shopify.com/*"],
      "js": ["Plugins/techbay-planner-plugin/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
