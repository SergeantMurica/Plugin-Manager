{
  "manifest_version": 3,
  "name": "Plugin Manager",
  "version": "1.0.0",
  "description": "Tabbed host for every plugin in the Plugins folder.",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "clipboardWrite",
    "alarms",
    "idle",
    "clipboardRead",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://*.gorgias.com/*",
    "https://app.ringcentral.com/*",
    "https://dash.metapcs.com/*",
    "https://metapcs-platform.web.app/*",
    "https://firestore.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://admin.shopify.com/*",
    "https://help.metapcs.com/*"
  ],
  "action": {
    "default_title": "Plugin Manager"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_host_permissions": [
    "https://*/*",
    "https://app.workmatepos.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://admin.shopify.com/*"
      ],
      "js": [
        "Plugins/Dashboard-Tool/warranty/content.js"
      ],
      "css": [
        "Plugins/Dashboard-Tool/warranty/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://dash.metapcs.com/*",
        "https://metapcs-platform.web.app/*"
      ],
      "js": [
        "Plugins/Dashboard-Tool/outreach/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://admin.shopify.com/*",
        "https://*.gorgias.com/*",
        "https://*.workmatepos.co/*"
      ],
      "js": [
        "Plugins/metapcs-toolbox/content/linkify.js"
      ],
      "css": [
        "Plugins/metapcs-toolbox/content/linkify.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://dash.metapcs.com/*",
        "https://metapcs-platform.web.app/*"
      ],
      "js": [
        "Plugins/techbay-planner-plugin/sku-discount.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://admin.shopify.com/*",
        "https://app.workmatepos.co/*"
      ],
      "js": [
        "Plugins/techbay-planner-plugin/lib/daily-update.js",
        "Plugins/techbay-planner-plugin/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}