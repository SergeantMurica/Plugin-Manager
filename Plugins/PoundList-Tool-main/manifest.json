{
  "manifest_version": 3,
  "name": "Pound List Tool",
  "version": "1.0.0",
  "description": "Call prompts, voicemails, texts and emails for working Dash Pound list leads (Claim 5). Reads the open lead and links warranty leads to the Warranty Upsell Tracker.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://dash.metapcs.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Pound List Tool"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dash.metapcs.com/*",

        "https://metapcs-platform.web.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}
