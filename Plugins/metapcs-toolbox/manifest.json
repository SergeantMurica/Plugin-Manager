{
  "manifest_version": 3,
  "name": "META PC Toolbox",
  "version": "1.1.0",
  "description": "Help Center search, UPS/FedEx tracking, WorkMate and Gorgias lookups, and clickable SO-# links.",
  "action": {
    "default_title": "META PC Toolbox (Alt+Shift+M)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "clipboardRead",
    "clipboardWrite",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://help.metapcs.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://admin.shopify.com/*",
        "https://*.gorgias.com/*",
        "https://*.workmatepos.co/*"
      ],
      "js": ["content/linkify.js"],
      "css": ["content/linkify.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Open META PC Toolbox"
    }
  }
}
