{
  "manifest_version": 3,
  "name": "Work Mate Assistant",
  "version": "1.1.0",
  "description": "Manage work-order notes in Shopify Admin and show in-store dollar and percentage discounts on Dash SKU pages.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": ["https://admin.shopify.com/*", "https://dash.metapcs.com/*", "https://metapcs-platform.web.app/*"],
  "optional_host_permissions": ["https://app.workmatepos.co/*"],
  "action": {
    "default_title": "Work Mate Assistant"
  },
  "content_scripts": [
    {
      "matches": ["https://dash.metapcs.com/*", "https://metapcs-platform.web.app/*"],
      "js": ["sku-discount.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://admin.shopify.com/*", "https://app.workmatepos.co/*"],
      "js": ["lib/daily-update.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
